    {"id":"unavailable-public-null-gear","hero":{"gear":null},"expected":{}},
    {"id":"unavailable-missing-gear","hero":{},"expected":{}},
    {"id":"legacy-explicit-hidden-gear","hero":{"gear":{"hidden":true}},"defaultState":"Hidden","expected":{}},
