        {"slot":"Gloves","red":false,"enhancement_level":100,"refine_level":12,"gear_level":999,"quality_key":"mythic","troop_label":"infantry"},
        {"slot":"Armour","red":true,"enhancement_level":100,"refine_level":12,"gear_level":999,"quality_key":"legendary","troop_label":"infantry"},
        {"slot":"Boots","red":false,"enhancement_level":40,"refine_level":12,"gear_level":999,"quality_key":"mythic","troop_label":"infantry"}
      ]},
      "expected": {
        "helmet":{"state":"available","tier":"Red","enhancement":"51","mastery":"12","artwork":"./scouting-assets/cutouts/infantry-helm.png"},
        "gloves":{"state":"available","tier":"Gold","enhancement":"100","mastery":"12","artwork":"./scouting-assets/cutouts/infantry-gloves.png"},
        "armour":{"state":"available","tier":"Red","enhancement":"—","mastery":"12","artwork":"./scouting-assets/cutouts/infantry-chest.png"},
        "boots":{"state":"available","tier":"Gold","enhancement":"40","mastery":"12","artwork":"./scouting-assets/cutouts/infantry-boots.png"}
      }
    },
