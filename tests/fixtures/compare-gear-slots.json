        {"slot":"Boots","red":false,"enhancement_level":40,"refine_level":12,"quality_key":"mythic","troop_label":"infantry"},
        {"slot":"Helmet","red":true,"enhancement_level":152,"refine_level":12,"quality_key":"legendary","troop_label":"infantry"},
        {"slot":"Helmet","red":true,"enhancement_level":151,"refine_level":12,"quality_key":"legendary","troop_label":"infantry"}
